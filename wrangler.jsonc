{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "a-world-made-of-her",
  "main": "./.output/server/index.mjs",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./.output/public",
    "binding": "ASSETS"
  },
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.mjs", "**/*.js"]
    }
  ]
}
